# --- Telegram ---
# Get from https://my.telegram.org -> API development tools
TG_API_ID=
TG_API_HASH=
TG_PHONE=+1234567890
TG_SESSION=telecall

# --- Voice agent ---
# Default: OpenAI Realtime API. Change VOICE_PROVIDER only when using another adapter.
VOICE_PROVIDER=openai
VOICE_SYSTEM_PROMPT="You are answering an incoming phone call. Be friendly, concise, and useful."

# --- OpenAI Realtime (default) ---
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime-2
OPENAI_REALTIME_VOICE=alloy
OPENAI_REALTIME_SPEED=1.08

# --- ElevenLabs Conversational AI (when VOICE_PROVIDER=elevenlabs) ---
ELEVENLABS_API_KEY=
EL_AGENT_ID=
# The voice and model are configured inside the ElevenLabs agent referenced by EL_AGENT_ID.

# --- Gemini Live (when VOICE_PROVIDER=gemini) ---
GOOGLE_API_KEY=
GEMINI_LIVE_MODEL=models/gemini-3.1-flash-live-preview
GEMINI_LIVE_VOICE=Aoede