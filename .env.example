# --- Telegram ---
# Get from https://my.telegram.org -> API development tools
TG_API_ID=
TG_API_HASH=
TG_PHONE=+1234567890
TG_SESSION=telecall

# --- Voice agent ---
# Which provider drives the call: elevenlabs | openai | gemini | grok | xai_turn
VOICE_PROVIDER=elevenlabs

# Optional system prompt used by OpenAI Realtime & Gemini Live
VOICE_SYSTEM_PROMPT="You are answering an incoming phone call. Be friendly, concise, and useful."

# --- xAI turn-based Chippy mode (when VOICE_PROVIDER=xai_turn) ---
# Streams caller audio to xAI STT, sends final transcript to OpenClaw/Chippy,
# then speaks the final reply with xAI TTS. Higher latency, but uses OpenClaw tools/memory.
XAI_API_KEY=
XAI_STT_SAMPLE_RATE=16000
XAI_STT_LANGUAGE=en
XAI_STT_ENDPOINTING_MS=700
XAI_TTS_VOICE=eve
XAI_TTS_SAMPLE_RATE=24000
XAI_TTS_SPEED_TAG=fast
OPENCLAW_VOICE_SESSION_ID=tgcallskill-voice
OPENCLAW_VOICE_TIMEOUT=180

# --- ElevenLabs (when VOICE_PROVIDER=elevenlabs) ---
ELEVENLABS_API_KEY=
EL_AGENT_ID=

# --- OpenAI Realtime (when VOICE_PROVIDER=openai) ---
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-4o-realtime-preview
OPENAI_REALTIME_VOICE=alloy

# --- Gemini Live (when VOICE_PROVIDER=gemini) ---
GOOGLE_API_KEY=
GEMINI_LIVE_MODEL=models/gemini-2.0-flash-exp
GEMINI_LIVE_VOICE=Aoede
